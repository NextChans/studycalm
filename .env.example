# Supabase Realtime 중계 (권장) — 443 포트로 연결되어 매장 Wi-Fi/사내망에서도 동작
# Supabase 대시보드 > Project Settings > API 의 Project URL / anon(publishable) key
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# (선택, Vercel 서버 환경변수) Google Cloud Text-to-Speech API 키
# 미설정 시 /api/tts 가 비공식 Google Translate TTS 로 폴백합니다.
# GOOGLE_TTS_API_KEY=
